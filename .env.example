# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin credentials (server-side only). Use a service account from Firebase.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store the private key with escaped newlines (\\n); never use a NEXT_PUBLIC_ variable.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Reserved for future server-side notifications
INTERNAL_NOTIFICATION_EMAIL=
NOTIFICATION_SENDER_EMAIL=
WHATSAPP_BUSINESS_NUMBER=