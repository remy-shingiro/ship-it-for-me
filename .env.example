# Public site configuration. Use the production HTTPS origin when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin credentials (server-side only). Use a service account from Firebase.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store the private key with escaped newlines (\\n); never use a NEXT_PUBLIC_ variable.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
